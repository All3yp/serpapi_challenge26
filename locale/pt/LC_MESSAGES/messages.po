msgid "Gap Finder — find the space in the literature"
msgstr "Gap Finder — encontre o espaço na literatura"

msgid "Google Scholar search + local research-gap analysis."
msgstr "Busca no Google Scholar + análise local de lacunas de pesquisa."

msgid "Research topic"
msgstr "Tema de pesquisa"

msgid "Number of papers"
msgstr "Número de papers"

msgid "Year window (start–end)"
msgstr "Janela de anos (início–fim)"

msgid "Citation style"
msgstr "Formato de citação"

msgid "Analyze gaps"
msgstr "Analisar lacunas"

msgid "Searching and analyzing…"
msgstr "Buscando e analisando…"

msgid "Gap opportunity score"
msgstr "Índice de oportunidade de gap"

msgid "Suggested directions"
msgstr "Direções sugeridas"

msgid "Temporal density"
msgstr "Densidade temporal"

msgid "Subtopic whitespace"
msgstr "Whitespace de subtópicos"

msgid "Citation stagnation"
msgstr "Estagnação de citações"

msgid "Declared open questions"
msgstr "Questões abertas declaradas"

msgid "Reading list"
msgstr "Reading list"

msgid "No results found."
msgstr "Nenhum resultado encontrado."

msgid "Share of papers from the last 3 years"
msgstr "Fração de papers dos últimos 3 anos"

msgid "paper"
msgid_plural "papers"
msgstr[0] "paper"
msgstr[1] "papers"

msgid "citation"
msgid_plural "citations"
msgstr[0] "citação"
msgstr[1] "citações"

msgid "Most-cited papers"
msgstr "Papers mais citados"

msgid "Underexplored terms"
msgstr "Termos pouco explorados"

msgid "Hot terms"
msgstr "Termos quentes"

msgid "No API key — running offline (fixtures). Set SERPAPIKEY and `record`/`online` mode for live data."
msgstr "Sem chave — rodando offline (fixtures). Defina SERPAPIKEY e o modo `record`/`online` para dados ao vivo."

msgid "Offline (replay): using fixtures, zero credits."
msgstr "Modo offline (replay): usando fixtures, zero crédito."

msgid "Top-5 year: %(avg_year)s · top-3 share: %(share)s"
msgstr "Top-5 ano: %(avg_year)s · top-3 share: %(share)s"

msgid "Underexplored subtopics (few papers, low citations): %(terms)s."
msgstr "Subtópicos pouco explorados (poucos papers, baixas citações): %(terms)s."

msgid "Citations are still concentrated on older work — a recent result with no strong follow-up is a candidate gap."
msgstr "Citações ainda concentradas em trabalhos antigos — um resultado recente sem desdobramento forte é um gap candidato."

msgid "Low publication activity in the last 3 years: verify whether the field declined or a space opened."
msgstr "Baixa atividade de publicação nos últimos 3 anos: verifique se o campo declinou ou se um espaço se abriu."

msgid "%(n)s paper explicitly declares open questions / future work: %(titles)s."
msgid_plural "%(n)s papers explicitly declare open questions / future work: %(titles)s."
msgstr[0] "%(n)s trabalho declara explicitamente questões abertas / trabalhos futuros: %(titles)s."
msgstr[1] "%(n)s trabalhos declaram explicitamente questões abertas / trabalhos futuros: %(titles)s."

msgid "Field looks saturated and recent — consider a narrower niche or a cross-domain angle."
msgstr "O campo parece saturado e recente — considere um nicho mais estreito ou um ângulo interdisciplinar."

msgid "Demand (Google Trends)"
msgstr "Demanda (Google Trends)"

msgid "No demand signal — run online to check Google Trends."
msgstr "Sem sinal de demanda — rode online para consultar o Google Trends."

msgid "Interest in \"%(term)s\" is rising (%(growth)+.1f on Google Trends) — an under-published subtopic with growing demand is a strong gap."
msgstr "O interesse em \"%(term)s\" está subindo (%(growth)+.1f no Google Trends) — um subtópico pouco publicado com demanda crescente é um gap forte."

msgid "Interest in \"%(term)s\" is falling (%(growth)+.1f) — verify whether the niche is dying or underserved."
msgstr "O interesse em \"%(term)s\" está caindo (%(growth)+.1f) — verifique se o nicho está morrendo ou é mal atendido."

msgid "Interest in \"%(term)s\" is flat (%(growth)+.1f) — a stable niche with room to publish."
msgstr "O interesse em \"%(term)s\" está estável (%(growth)+.1f) — um nicho estável com espaço para publicar."

msgid "Demand score: %(score)s/100"
msgstr "Score de demanda: %(score)s/100"

msgid "Download .bib"
msgstr "Baixar .bib"

msgid "Download .csv"
msgstr "Baixar .csv"

msgid "Download .txt"
msgstr "Baixar .txt"

msgid "Directions"
msgstr "Direções"

msgid "Open questions"
msgstr "Questões abertas"

msgid "Wide open"
msgstr "Campo aberto"

msgid "Some gaps"
msgstr "Algumas lacunas"

msgid "Crowded"
msgstr "Saturado"

msgid "Offline mode"
msgstr "Modo offline"

msgid "Online mode"
msgstr "Modo online"

msgid "No API key"
msgstr "Sem chave"

msgid "Temporal"
msgstr "Temporal"

msgid "Whitespace"
msgstr "Whitespace"

msgid "Stagnation"
msgstr "Estagnação"

msgid "Open"
msgstr "Abertas"

msgid "Search mode"
msgstr "Modo de busca"

msgid "Offline (replay)"
msgstr "Offline (replay)"

msgid "Online (live)"
msgstr "Online (ao vivo)"

msgid "Record (live + save)"
msgstr "Gravar (ao vivo + salvar)"

msgid "Record mode"
msgstr "Modo gravação"

msgid "No API key set — live search needs SERPAPIKEY. Falling back to offline (replay)."
msgstr "Sem chave de API — a busca ao vivo precisa de SERPAPIKEY. Voltando para offline (replay)."
